# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.
# Em produção, defina estas variáveis diretamente no painel da plataforma de
# hospedagem (Render/Railway/Vercel) — nunca comite o ".env" real.

# Banco de dados — SQLite em dev; em produção aponte para um Postgres gerenciado
# (o Render cria essa URL automaticamente se você usar o render.yaml deste repo).
DATABASE_URL=sqlite:///./saas_cameras.db
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# JWT
SECRET_KEY=troque-esta-chave-por-uma-string-aleatoria-longa
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Bootstrap do SUPER_ADMIN — criado automaticamente no primeiro startup se ainda
# não existir nenhuma conta com esse papel. Depois disso, é uma conta normal:
# faça login com essas credenciais e troque a senha pelo próprio painel.
SUPER_ADMIN_EMAIL=admin@visionsaas.com
SUPER_ADMIN_PASSWORD=admin123

# URL pública do frontend — usada para montar as URLs de retorno do Stripe
# Checkout/Customer Portal e como origem padrão de CORS (ver CORS_ORIGINS).
FRONTEND_URL=http://localhost:5173
# URL pública deste backend (ex.: https://seu-app.onrender.com) — só usada para
# logar, no startup, o endpoint exato a cadastrar como webhook na Stripe.
BACKEND_URL=http://localhost:8000

# Stripe — chaves de TESTE em dev (Dashboard da Stripe > Developers > API keys);
# troque para pk_live_.../sk_live_... ao publicar de verdade. Sem elas, o
# autocadastro (POST /api/auth/signup) responde 503 — o pagamento é
# obrigatório para toda conta nova, não há acesso sem Stripe configurada. Para
# testar o webhook localmente, instale a Stripe CLI e rode:
# stripe listen --forward-to localhost:8000/api/webhooks/stripe
# (o comando imprime o whsec_... a usar em STRIPE_WEBHOOK_SECRET).
STRIPE_PUBLISHABLE_KEY=pk_test_substitua
STRIPE_SECRET_KEY=sk_test_substitua
STRIPE_WEBHOOK_SECRET=whsec_substitua
# Price ID (price_...) do plano único da plataforma — "Plano Completo",
# assinatura mensal recorrente de R$ 0,05 — criado no Dashboard da Stripe
# (Products > Add product > Recurring > BRL 0,05/mês).
STRIPE_PRICE_ID_UNICO=price_substitua_unico

# E-mails transacionais (Resend — https://resend.com/api-keys). Sem a chave, os
# envios de boas-vindas/confirmação de assinatura são só logados, não quebram
# o cadastro nem o webhook.
RESEND_API_KEY=re_substitua
EMAIL_FROM=VisionSaaS <onboarding@resend.dev>

# Visão computacional
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONF_THRESHOLD=0.35
YOLO_TRACKER=bytetrack.yaml
STREAM_JPEG_QUALITY=80
STREAM_TARGET_FPS=15
BLUR_KERNEL=51

# Regras de negócio por perfil de câmera (heurísticas ajustáveis)
ATENDIMENTO_MIN_SEGUNDOS=15
CLIENTE_COOLDOWN_SEGUNDOS=30
ESCRITORIO_INATIVIDADE_SEGUNDOS=300
MOVIMENTO_MINIMO_NORMALIZADO=0.015
ESTOQUE_ESTAGNACAO_SEGUNDOS=120
ESTOQUE_GRID_COLUNAS=8
ESTOQUE_GRID_LINHAS=6
OCUPACAO_AMOSTRA_SEGUNDOS=30

# CORS (separado por vírgula, ou * para liberar tudo)
CORS_ORIGINS=*
